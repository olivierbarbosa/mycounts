# Gabarit des environnements de déploiement.
#
# Copier en infra/.env.prod et infra/.env.dev — ces deux-là ne sont JAMAIS commités.
# Chaque pile est indépendante : sa propre base, son propre volume, son propre domaine.

# Nom de la pile Docker : sert de préfixe aux conteneurs et au volume de données.
# En changer revient à repartir d'une base vide — ce n'est pas un libellé cosmétique.
MYCOUNTS_PILE=mycounts-prod

# Suffixe des routeurs Traefik. Doit être unique sur la machine : deux routeurs de même
# nom se remplacent silencieusement, et une pile disparaît sans erreur.
MYCOUNTS_SUFFIXE=prod

# Nom d'hôte servi. Le front ET l'API répondent dessus (même origine, cf. le compose).
MYCOUNTS_DOMAINE=mycounts.app

# Toute valeur autre que « developpement » impose le drapeau « secure » sur le cookie
# de session. Ne jamais mettre « developpement » sur une pile exposée.
MYCOUNTS_ENVIRONNEMENT=production

# Mot de passe PostgreSQL — à générer, jamais à réutiliser entre les piles.
#   openssl rand -base64 30 | tr -d '/+=' | head -c 32
MYCOUNTS_DB_MOT_DE_PASSE=

# Catégorisation assistée à l'import (facultative). Vide, l'import fonctionne pareil.
MYCOUNTS_CLE_OPENROUTER=
MYCOUNTS_MODELE_IA=mistralai/mistral-nemo
