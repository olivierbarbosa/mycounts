# Gabarit des environnements de déploiement.
#
# Copier en infra/.env.prod et infra/.env.dev — ces deux-là ne sont JAMAIS commités.
# Chaque pile est indépendante : sa propre base, son propre volume, son propre domaine.

# Nom de la pile Docker : sert de préfixe aux conteneurs et au volume de données.
# En changer revient à repartir d'une base vide — ce n'est pas un libellé cosmétique.
MYCOUNTS_PILE=mycounts-prod

# Suffixe des routeurs Traefik. Doit être unique sur la machine : deux routeurs de même
# nom se remplacent silencieusement, et une pile disparaît sans erreur.
MYCOUNTS_SUFFIXE=prod

# Nom d'hôte servi. Le front ET l'API répondent dessus (même origine, cf. le compose).
MYCOUNTS_DOMAINE=mycounts.app

# Toute valeur autre que « developpement » impose le drapeau « secure » sur le cookie
# de session. Ne jamais mettre « developpement » sur une pile exposée.
MYCOUNTS_ENVIRONNEMENT=production

# Mot de passe PostgreSQL — à générer, jamais à réutiliser entre les piles.
#   openssl rand -base64 30 | tr -d '/+=' | head -c 32
MYCOUNTS_DB_MOT_DE_PASSE=

# Au moins 32 caractères aléatoires. Sert de clé HMAC pour ne jamais conserver les
# adresses de connexion ou IP en clair dans les compteurs de sécurité.
MYCOUNTS_CLE_HMAC_AUTH=

# Nom du conteneur Traefik sur le réseau Docker `web` : « traefik », le proxy dédié du
# dépôt ~/proxy, qui n'appartient à aucune application. Uvicorn n'accepte ses en-têtes
# X-Forwarded-* que depuis l'adresse résolue de ce conteneur.
MYCOUNTS_PROXY_FIABLE_HOTE=traefik

# Catégorisation assistée à l'import (facultative). Vide, l'import fonctionne pareil.
MYCOUNTS_CLE_OPENROUTER=
MYCOUNTS_MODELE_IA=mistralai/mistral-nemo

# La famille/amis reste fermée. Passer à true seulement après la revue d'ouverture.
MYCOUNTS_INSCRIPTIONS_OUVERTES=false

# Alertes d'exploitation en push sur le téléphone (infra/alerter.sh), par ntfy. Le nom
# du sujet tient lieu de secret : https://ntfy.sh/mycounts-<24 caractères aléatoires>.
# Vide : rien ne part, et ~/mycounts-alertes.log le dit.
MYCOUNTS_ALERTE_URL=

# OVH Zimbra. Le mot de passe réel reste exclusivement dans .env.prod/.env.dev.
MYCOUNTS_SMTP_HOTE=smtp.mail.ovh.net
MYCOUNTS_SMTP_PORT=465
MYCOUNTS_SMTP_UTILISATEUR=no-reply@mycounts.app
MYCOUNTS_SMTP_MOT_DE_PASSE=
MYCOUNTS_SMTP_SSL=true
MYCOUNTS_SMTP_STARTTLS=false
MYCOUNTS_COURRIEL_EXPEDITEUR=no-reply@mycounts.app
MYCOUNTS_COURRIEL_SUPPORT=support@mycounts.app
