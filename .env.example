# Copier en .env — .env n'est JAMAIS commité (garde-fou CI n°2)
MYCOUNTS_DATABASE_URL=postgresql+psycopg://mycounts:mycounts@localhost:5434/mycounts
MYCOUNTS_FUSEAU=Europe/Paris

# Facultative uniquement en développement. Obligatoire et aléatoire en production.
MYCOUNTS_CLE_HMAC_AUTH=

# Catégorisation assistée à l'import (facultative).
# Sans cette clé, l'import fonctionne exactement pareil : les correspondances apprises et
# le tableau par défaut suffisent à ranger les deux tiers d'un relevé. Avec elle, les
# LIBELLÉS des lignes restantes — et rien d'autre — sont envoyés à OpenRouter.
# Voir backend/mycounts/services/categorisation_ia.py, seule porte de sortie du projet.
MYCOUNTS_CLE_OPENROUTER=
MYCOUNTS_MODELE_IA=mistralai/mistral-nemo

MYCOUNTS_INSCRIPTIONS_OUVERTES=false
MYCOUNTS_URL_PUBLIQUE=http://localhost:5189
MYCOUNTS_SMTP_HOTE=
MYCOUNTS_SMTP_PORT=465
MYCOUNTS_SMTP_UTILISATEUR=
MYCOUNTS_SMTP_MOT_DE_PASSE=
MYCOUNTS_SMTP_SSL=true
MYCOUNTS_SMTP_STARTTLS=false
MYCOUNTS_COURRIEL_EXPEDITEUR=no-reply@mycounts.app
MYCOUNTS_COURRIEL_SUPPORT=support@mycounts.app
